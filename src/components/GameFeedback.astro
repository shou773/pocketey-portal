---
import en from "@locales/en.json";

type Props = {
  slug: string;
  title: string;
};

const { slug, title } = Astro.props;
---

<section
  class="mx-auto flex max-w-md flex-col items-center gap-3"
  data-feedback={slug}
  data-game-title={title}
  aria-label="Rate or report"
>
  <div
    class="flex items-stretch gap-1 rounded-full border-4 border-[#1a0a30] bg-white px-2 py-1 shadow-[0_4px_0_#1a0a30]"
  >
    <button
      type="button"
      class="vote-btn"
      data-vote="up"
      aria-label={en["ui.feedback.like"]}
    >
      <span class="text-xl leading-none" aria-hidden="true">👍</span>
      <span class="vote-pct nums" data-pct>—</span>
    </button>
    <span class="self-stretch w-px bg-[#1a0a30]/15" aria-hidden="true"></span>
    <button
      type="button"
      class="vote-btn"
      data-vote="down"
      aria-label={en["ui.feedback.dislike"]}
    >
      <span class="text-xl leading-none" aria-hidden="true">👎</span>
    </button>
  </div>

  <div class="flex items-center gap-3 text-sm">
    <span class="opacity-70 nums" data-total>—</span>
    <button type="button" class="report-btn" data-report-trigger>
      <span aria-hidden="true">🐛</span>
      <span>{en["ui.feedback.report"]}</span>
    </button>
  </div>

  <dialog class="report-dialog">
    <form method="dialog" data-report-form>
      <header>
        <h3 class="text-lg font-extrabold">
          {en["ui.feedback.reportTitle"]}
        </h3>
        <p class="mt-1 text-sm opacity-70" data-report-subtitle>
          {title}
        </p>
      </header>

      <label class="block">
        <span class="text-xs uppercase tracking-widest opacity-70">
          {en["ui.feedback.whatHappened"]}
        </span>
        <textarea
          name="message"
          required
          minlength="5"
          maxlength="2000"
          rows="4"
          placeholder={en["ui.feedback.messagePlaceholder"]}
        ></textarea>
      </label>

      <label class="block">
        <span class="text-xs uppercase tracking-widest opacity-70">
          {en["ui.feedback.browserNote"]}
        </span>
        <input
          name="browserNote"
          type="text"
          maxlength="200"
          placeholder={en["ui.feedback.browserPlaceholder"]}
        />
      </label>

      <p class="text-xs opacity-60">
        {en["ui.feedback.privacyNote"]}
      </p>

      <p class="report-status" data-report-status aria-live="polite"></p>

      <footer>
        <button
          type="button"
          class="btn-ghost text-sm"
          data-report-cancel
        >
          {en["ui.feedback.cancel"]}
        </button>
        <button
          type="submit"
          class="btn-primary text-sm"
          data-report-submit
        >
          {en["ui.feedback.send"]}
        </button>
      </footer>
    </form>
  </dialog>
</section>

<script is:inline>
  (function () {
    const root = document.currentScript?.previousElementSibling;
    if (!(root instanceof HTMLElement)) return;
    const slug = root.dataset.feedback;
    if (!slug) return;

    const STORAGE_KEY = `pocketey:vote:${slug}`;
    const upBtn = root.querySelector('[data-vote="up"]');
    const downBtn = root.querySelector('[data-vote="down"]');
    const pctEl = root.querySelector("[data-pct]");
    const totalEl = root.querySelector("[data-total]");
    const reportTrigger = root.querySelector("[data-report-trigger]");
    const dialog = root.querySelector("dialog");
    const form = root.querySelector("[data-report-form]");
    const status = root.querySelector("[data-report-status]");
    const cancelBtn = root.querySelector("[data-report-cancel]");
    const submitBtn = root.querySelector("[data-report-submit]");

    let counts = { up: 0, down: 0 };
    let yourVote = null; // "up" | "down" | null
    let inflight = false;

    try {
      yourVote = localStorage.getItem(STORAGE_KEY);
      if (yourVote !== "up" && yourVote !== "down") yourVote = null;
    } catch {}

    function render() {
      const total = counts.up + counts.down;
      if (total === 0) {
        if (pctEl) pctEl.textContent = "—";
        if (totalEl) totalEl.textContent = "Be the first to rate";
      } else {
        const pct = Math.round((counts.up / total) * 100);
        if (pctEl) pctEl.textContent = pct + "%";
        if (totalEl)
          totalEl.textContent =
            total === 1 ? "1 vote" : total.toLocaleString() + " votes";
      }
      [upBtn, downBtn].forEach((btn) => {
        if (!btn) return;
        const v = btn.getAttribute("data-vote");
        if (yourVote === v) btn.setAttribute("data-active", "true");
        else btn.removeAttribute("data-active");
        btn.toggleAttribute("disabled", inflight);
      });
    }

    async function loadCounts() {
      try {
        const res = await fetch(`/api/votes?slug=${encodeURIComponent(slug)}`);
        if (!res.ok) return;
        const data = await res.json();
        counts = {
          up: Number(data.up) || 0,
          down: Number(data.down) || 0,
        };
        render();
      } catch {
        // Network or 404 in dev — silent
      }
    }

    async function vote(value) {
      if (inflight) return;
      inflight = true;
      const previous = yourVote;
      const previousCounts = { ...counts };
      // Optimistic update
      if (yourVote === value) {
        counts[value] = Math.max(0, counts[value] - 1);
        yourVote = null;
      } else if (yourVote) {
        counts[yourVote] = Math.max(0, counts[yourVote] - 1);
        counts[value] += 1;
        yourVote = value;
      } else {
        counts[value] += 1;
        yourVote = value;
      }
      render();

      try {
        const res = await fetch("/api/vote", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ slug, value }),
        });
        if (!res.ok) throw new Error("vote failed " + res.status);
        const data = await res.json();
        counts = {
          up: Number(data.up) || 0,
          down: Number(data.down) || 0,
        };
        yourVote = data.your === "up" || data.your === "down" ? data.your : null;
        try {
          if (yourVote) localStorage.setItem(STORAGE_KEY, yourVote);
          else localStorage.removeItem(STORAGE_KEY);
        } catch {}
      } catch (err) {
        // Rollback
        counts = previousCounts;
        yourVote = previous;
        console.warn("vote failed, rolled back", err);
      } finally {
        inflight = false;
        render();
      }
    }

    upBtn?.addEventListener("click", () => vote("up"));
    downBtn?.addEventListener("click", () => vote("down"));

    function openReport() {
      if (!dialog) return;
      if (status) status.textContent = "";
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    }
    function closeReport() {
      if (!dialog) return;
      if (typeof dialog.close === "function") dialog.close();
      else dialog.removeAttribute("open");
    }

    reportTrigger?.addEventListener("click", openReport);
    cancelBtn?.addEventListener("click", closeReport);

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form) return;
      const fd = new FormData(form);
      const message = String(fd.get("message") || "").trim();
      const browserNote = String(fd.get("browserNote") || "").trim();
      if (message.length < 5) {
        if (status) status.textContent = "Please describe what happened (5+ characters).";
        return;
      }
      if (submitBtn) submitBtn.setAttribute("disabled", "");
      if (status) status.textContent = "Sending…";
      try {
        const res = await fetch("/api/report", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            slug,
            message,
            browserNote,
            url: location.href,
          }),
        });
        if (res.status === 429) {
          if (status)
            status.textContent =
              "Too many reports recently — please try again later.";
        } else if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          if (status)
            status.textContent =
              "Could not send report" + (data?.error ? ": " + data.error : ".");
        } else {
          if (status) status.textContent = "Thanks — report sent.";
          form.reset();
          setTimeout(closeReport, 1500);
        }
      } catch (err) {
        if (status) status.textContent = "Network error — please try again.";
      } finally {
        if (submitBtn) submitBtn.removeAttribute("disabled");
      }
    });

    render();
    loadCounts();
  })();
</script>

<style>
  .vote-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    font-weight: 700;
    color: #1a0a30;
    transition: background 0.15s ease, transform 0.1s ease;
    cursor: pointer;
  }
  .vote-btn:hover:not([disabled]) {
    background: #fff7ea;
  }
  .vote-btn[data-active="true"] {
    background: #ffb020;
    color: #1a0a30;
  }
  .vote-btn[disabled] {
    opacity: 0.5;
    cursor: progress;
  }
  .vote-pct {
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
  }

  .report-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    border: 2px solid #1a0a30;
    background: #fff;
    font-weight: 700;
    transition: background 0.15s ease, transform 0.1s ease;
    cursor: pointer;
  }
  .report-btn:hover {
    background: #fff7ea;
    transform: translateY(-1px);
  }

  .report-dialog {
    border: 4px solid #1a0a30;
    border-radius: 1.5rem;
    padding: 1.5rem;
    max-width: min(440px, 92vw);
    width: 100%;
    background: #fff;
    color: #1a0a30;
    box-shadow: 0 10px 0 #1a0a30;
  }
  .report-dialog::backdrop {
    background: rgba(26, 10, 48, 0.55);
    backdrop-filter: blur(2px);
  }
  .report-dialog form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-align: left;
  }
  .report-dialog textarea,
  .report-dialog input[type="text"] {
    margin-top: 0.3rem;
    width: 100%;
    border: 2px solid #1a0a30;
    border-radius: 0.75rem;
    padding: 0.55rem 0.75rem;
    font: inherit;
    background: #fff;
    color: #1a0a30;
    resize: vertical;
  }
  .report-dialog textarea:focus,
  .report-dialog input[type="text"]:focus {
    outline: 3px solid #ffb020;
    outline-offset: 1px;
  }
  .report-dialog footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .report-status {
    min-height: 1.25rem;
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }
</style>
