---
/**
 * AdSense display ad slot.
 *
 * Renders a `<ins class="adsbygoogle">` tag in production iff the requested
 * slot has an entry in ADSENSE_SLOTS (in `src/utils/site.ts`) with a non-
 * empty 10-digit data-ad-slot value. Slots with empty IDs render nothing
 * in production — this lets us wire up call sites before all units are
 * configured in AdSense, without shipping malformed ad tags.
 *
 * In dev (PROD=false) the slot renders a placeholder so designers can see
 * where ads will appear.
 *
 * The AdSense loader script is added globally by BaseLayout.astro, so this
 * component only needs to emit the <ins> + adsbygoogle.push() call.
 */
import { SITE, ADSENSE_SLOTS } from "@utils/site";

type Format = "banner" | "rectangle" | "rewarded-video";
type Network = "adsense" | "crazygames" | "gamemonetize" | "auto";

type Props = {
  slot: string;
  format?: Format;
  network?: Network;
  fallback?: string;
  className?: string;
};

const {
  slot,
  format = "banner",
  network = "auto",
  fallback,
  className = "",
} = Astro.props;

const SIZES: Record<Format, { w: number; h: number; label: string }> = {
  banner: { w: 320, h: 50, label: "320×50 banner" },
  rectangle: { w: 300, h: 250, label: "300×250 rectangle" },
  "rewarded-video": { w: 240, h: 64, label: "rewarded video" },
};
const size = SIZES[format];
const isProd = import.meta.env.PROD;

// Look up the configured AdSense ad-unit slot id. Empty = not yet wired
// in AdSense; we skip rendering ad tags entirely so we don't ship invalid
// AdSense slot IDs (which can trigger policy violations).
const adSlotId = (ADSENSE_SLOTS[slot] ?? "").trim();
const adsenseId = SITE.adsenseId;
const showRealAd = isProd && adSlotId !== "" && Boolean(adsenseId);
const showDevPlaceholder = !isProd;
---

{
  showRealAd && (
    <>
      <ins
        class={`adsbygoogle block ${className}`}
        style="display:block"
        data-ad-client={adsenseId}
        data-ad-slot={adSlotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
        data-slot-name={slot}
        data-format={format}
      />
      <script is:inline define:vars={{ slot }}>
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch (e) {
          console.warn("[AdSense] push failed for slot " + slot, e);
        }
      </script>
    </>
  )
}
{
  showDevPlaceholder && (
    <div
      data-adslot={slot}
      data-adformat={format}
      data-adnetwork={network}
      data-adslot-configured={adSlotId !== "" ? "yes" : "no"}
      style={`width:${size.w}px;height:${size.h}px`}
      class={`mx-auto flex items-center justify-center rounded-md border border-[#1a0a30]/15 bg-[#1a0a30]/5 text-[10px] uppercase tracking-widest text-[#1a0a30]/55 ${className}`}
    >
      {fallback ?? `${slot} · ${size.label}${adSlotId === "" ? " · (no id)" : ""}`}
    </div>
  )
}
