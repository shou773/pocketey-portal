---
import { gamePlayUrl } from "@utils/site";

type Props = {
  slug: string;
  title: string;
  orientation: "portrait" | "landscape" | "both";
};

const { slug, title, orientation } = Astro.props;
const aspect = orientation === "landscape" ? "16/9" : "9/16";
const playPath = gamePlayUrl(slug);
---

<div class="relative">
  <div
    class="mx-auto overflow-hidden rounded-3xl border-4 border-[#1a0a30] bg-black shadow-[0_8px_0_#1a0a30]"
    style={`aspect-ratio:${aspect};max-width:${orientation === "landscape" ? "100%" : "min(420px, 90vw)"}`}
  >
    <iframe
      src={playPath}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; gyroscope; fullscreen"
      allowfullscreen
      class="h-full w-full border-0"
      data-game-frame={slug}></iframe>
  </div>
  <div class="mt-3 flex justify-center gap-2">
    <a class="btn-ghost text-sm" href={playPath} target="_blank" rel="noopener">
      Open Fullscreen
    </a>
  </div>
</div>
