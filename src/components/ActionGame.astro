---
const { kind, title, subtitle } = Astro.props;
import '../games/game.css';
import '../games/ui.css';
---
<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#101429"/><title>{title} — Pocketey Games</title><meta name="description" content={subtitle}/><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/>{['trophy','rotate-ccw','sparkles','check'].map(name => <link rel="preload" as="image" href={`/games/assets/lucide/${name}.svg`}/>)}</head>
<body class={kind}>
<main id="game" data-kind={kind}>
  <header class="game-bar"><a href="/games/" class="wordmark">POCKETEY <span> / PLAY</span></a><div><button id="sound" aria-label="音を切り替え" aria-pressed="false">音 OFF</button><button id="pause" disabled>一時停止</button></div></header>
  <div id="view"><canvas id="scene" aria-label={`${title} の3Dゲーム画面`}></canvas><div class="vignette"></div>
    <div class="hud"><div><span id="stage-label">01 / 03</span><strong id="stage-name"></strong></div><div class="time"><span id="timer">0.00</span><small>SECONDS</small></div></div>
    <div class="progress"><div id="progress-fill"></div></div>
    <div id="overlay" class="overlay"><section class="panel" aria-labelledby="panel-title"><p id="eyebrow">POCKETEY ORIGINAL · 3 STAGES</p><div class="hero-mark" aria-hidden="true"><span id="panel-icon" class="asset-icon" style={`--icon: url('/games/assets/lucide/${kind === 'orbit' ? 'orbit' : 'gem'}.svg')`}></span></div><h1 id="panel-title">{title}</h1><p id="panel-copy">{subtitle}</p><div id="stages" class="stages"></div><p id="instructions"></p><div id="actions"></div><p id="save-note" role="status"></p><button id="reset" class="text-button">この2作品の記録をリセット</button><div class="panel-links"><a href="/games/" class="back-link">ゲーム一覧へ</a><a href="/games/assets/lucide/LICENSE.txt" class="asset-credit" target="_blank" rel="noopener">素材ライセンス</a></div></section></div>
    <div id="landing-cue" aria-hidden="true"></div>
    <p id="hint"></p>
  </div>
  <footer class="controls"><div class="direction"><button data-input="left" aria-label="左へ移動"><span class="asset-icon" aria-hidden="true" style="--icon:url('/games/assets/lucide/arrow-left.svg')"></span></button><button data-input="right" aria-label="右へ移動"><span class="asset-icon" aria-hidden="true" style="--icon:url('/games/assets/lucide/arrow-right.svg')"></span></button></div><span class="control-note">MOVE<br/><small>← → / A D</small></span><button data-input="jump" class="jump" aria-label="ジャンプ">JUMP <span class="asset-icon" aria-hidden="true" style="--icon:url('/games/assets/lucide/arrow-up-right.svg')"></span></button></footer>
</main>
<script>import { boot } from '../games/app'; boot();</script>
</body></html>
