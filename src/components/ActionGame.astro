---
const { kind, title, subtitle } = Astro.props;
import LocaleHead from './LocaleHead.astro';
import GameMeta from './GameMeta.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import T from './T.astro';
const descriptionEn=kind==='orbit'?'An automatic 3D runner. Steer around pillars and jump the gaps across three short stages.':'A side-view 2.5D platformer. Move and jump across three short stages.';
import '../games/game.css';
import '../games/ui.css';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><LocaleHead/><meta name="theme-color" content="#101429"/><GameMeta name={title} description={descriptionEn} descriptionJa={subtitle} slug={kind==='orbit'?'orbit-ribbon':'amber-step'}/>{['trophy','rotate-ccw','sparkles','check'].map(name => <link rel="preload" as="image" href={`/games/assets/lucide/${name}.svg`}/>)}</head>
<body class={kind}>
<main id="game" data-kind={kind}>
  <header class="game-bar"><a href="/games/" class="wordmark">POCKETEY <span> / PLAY</span></a><div><button id="sound" aria-label="Toggle sound" aria-pressed="false"><T ja="音 OFF" en="Sound OFF"/></button><button id="pause" disabled><T ja="一時停止" en="Pause"/></button></div></header>
  <div id="view"><canvas id="scene" aria-label={`${title} 3D game`}></canvas><div class="vignette"></div>
    <div class="hud"><div><span id="stage-label">01 / 03</span><strong id="stage-name"></strong></div><div class="time"><span id="timer">0.00</span><small>SECONDS</small></div></div>
    <div class="progress"><div id="progress-fill"></div></div>
    <div id="overlay" class="overlay"><section class="panel" aria-labelledby="panel-title"><div class="game-language"><LanguageSwitch/></div><p id="eyebrow">POCKETEY ORIGINAL · 3 STAGES</p><div class="hero-mark" aria-hidden="true"><span id="panel-icon" class="asset-icon" style={`--icon: url('/games/assets/lucide/${kind === 'orbit' ? 'orbit' : 'gem'}.svg')`}></span></div><h1 id="panel-title">{title}</h1><p id="panel-copy"><T ja={subtitle} en={descriptionEn}/></p><div id="stages" class="stages"></div><p id="instructions"></p><div id="actions"></div><p id="save-note" role="status"></p><button id="reset" class="text-button">この2作品の記録をリセット</button><div class="panel-links"><a href="/games/" class="back-link"><T ja="ゲーム一覧へ" en="All games"/></a><a href="/games/assets/lucide/LICENSE.txt" class="asset-credit" target="_blank" rel="noopener" data-no-locale><T ja="素材ライセンス" en="Artwork licenses"/></a></div></section></div>
    <div id="landing-cue" aria-hidden="true"></div>
    <p id="hint"></p>
  </div>
  <footer class="controls"><div class="direction"><button data-input="left" aria-label="Move left"><span class="asset-icon" aria-hidden="true" style="--icon:url('/games/assets/lucide/arrow-left.svg')"></span></button><button data-input="right" aria-label="Move right"><span class="asset-icon" aria-hidden="true" style="--icon:url('/games/assets/lucide/arrow-right.svg')"></span></button></div><span class="control-note">MOVE<br/><small>← → / A D</small></span><button data-input="jump" class="jump" aria-label="Jump">JUMP <span class="asset-icon" aria-hidden="true" style="--icon:url('/games/assets/lucide/arrow-up-right.svg')"></span></button></footer>
</main>
<script>import { boot } from '../games/app'; boot();</script>
</body></html>
