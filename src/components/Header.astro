---
import { SITE, FEATURES } from "@utils/site";
import en from "@locales/en.json";
---

<header class="border-b-4 border-[#1a0a30] bg-[#fff7ea]">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 safe-x">
    <a href="/" class="flex items-center gap-2">
      <span
        class="text-2xl font-extrabold tracking-tight text-stroke-ink text-amber-300"
      >
        Pocketey
      </span>
      <span class="hidden text-xs font-bold uppercase tracking-widest opacity-60 sm:inline">
        {SITE.tagline}
      </span>
    </a>
    <nav class="flex items-center gap-1 text-sm font-bold sm:gap-3">
      <a
        href="/"
        class="rounded-full px-3 py-1.5 hover:bg-[#1a0a30] hover:text-amber-300"
      >
        {en["nav.home"]}
      </a>
      {FEATURES.blog && (
        <a
          href="/blog/"
          class="rounded-full px-3 py-1.5 hover:bg-[#1a0a30] hover:text-amber-300"
        >
          {en["nav.blog"]}
        </a>
      )}
      <a
        href="/about/"
        class="rounded-full px-3 py-1.5 hover:bg-[#1a0a30] hover:text-amber-300"
      >
        {en["nav.about"]}
      </a>
    </nav>
  </div>
</header>
