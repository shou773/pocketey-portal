---
import T from './T.astro';
import LanguageSwitch from './LanguageSwitch.astro';
---
<header class="site-header"><div class="container bar"><a class="brand" href="/" aria-label="Pocketey Games"><span class="mark" aria-hidden="true">P</span><span><b>POCKETEY</b><small>SMALL WORLDS / BIG PLAY</small></span></a><nav aria-label="Pocketey"><a href="/games/"><T ja="ゲーム" en="Games"/></a><a href="/about/"><T ja="このサイトについて" en="About"/></a></nav><LanguageSwitch/></div></header>
<style>.site-header{border-bottom:1px solid var(--line);background:var(--paper)}.bar{min-height:84px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;padding-block:16px}.brand{display:flex;align-items:center;gap:10px}.mark{width:37px;height:37px;display:grid;place-items:center;background:var(--ink);color:var(--paper);border-radius:13px;font-weight:800}.brand b{font-size:14px;letter-spacing:.15em}.brand small{display:block;font-size:7px;letter-spacing:.14em;margin-top:2px;color:var(--muted)}nav{display:flex;gap:22px;margin-left:auto;font-size:13px}.bar :global(.language-switch){margin-left:8px}@media(max-width:600px){.bar{gap:12px;justify-content:space-between}.brand small{display:none}.brand b{font-size:12px}.mark{width:30px;height:30px;border-radius:10px}nav{order:3;width:100%;margin:0;justify-content:center;font-size:12px}.bar :global(.language-switch){margin-left:0}}</style>
