---
import type { CollectionEntry } from "astro:content";
import { gameAssetUrl, gameUrl } from "@utils/site";
import categories from "@data/categories.json";

type Props = {
  game: CollectionEntry<"games">;
  loading?: "eager" | "lazy";
};

const { game, loading = "lazy" } = Astro.props;
const data = game.data;
const cat = categories.find((c) => c.slug === data.category);
const thumb = gameAssetUrl(data.slug, data.thumbnail);
---

<a
  href={gameUrl(data.slug)}
  class="pop-card group block overflow-hidden"
  aria-label={`Play ${data.title}`}
>
  <div class="relative aspect-[3/2] overflow-hidden bg-[#1a0a30]">
    <img
      src={thumb}
      alt={data.title}
      width="600"
      height="400"
      loading={loading}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    {
      data.featured && (
        <div class="absolute right-2 top-2 rounded-full bg-amber-300 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-widest text-zinc-900">
          Featured
        </div>
      )
    }
    {
      cat && (
        <div
          class="absolute left-2 bottom-2 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white"
          style={`background:${cat.color}`}
        >
          {cat.name.en}
        </div>
      )
    }
  </div>
  <div class="p-4">
    <h3 class="text-lg font-extrabold leading-tight">{data.title}</h3>
    <p class="mt-1 line-clamp-2 text-sm opacity-70">{data.tagline}</p>
    <div class="mt-3 flex items-center justify-between text-xs opacity-60">
      <span>{data.playTime}</span>
      <span class="capitalize">{data.orientation}</span>
    </div>
  </div>
</a>
