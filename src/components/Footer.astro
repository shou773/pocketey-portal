---
import T from './T.astro';
---
<footer><div class="container footer-grid"><div><a class="footer-brand" href="/">POCKETEY GAMES</a><p><T ja="小さな冒険を、ポケットに。" en="Small adventures, one more try."/></p><p class="muted"><T ja="ブラウザで遊べる、オリジナルゲーム。" en="Original games you can play in your browser."/></p></div><nav aria-label="Pocketey information"><a href="/games/"><T ja="ゲーム一覧" en="All games"/></a><a href="/about/"><T ja="このサイトについて" en="About"/></a><a href="/privacy/"><T ja="プライバシー" en="Privacy"/></a><a href="/contact/"><T ja="お問い合わせ" en="Contact"/></a></nav></div><p class="container legal">© {new Date().getFullYear()} Pocketey.</p></footer>
<style>footer{margin-top:76px;padding:44px 0 20px;border-top:1px solid var(--line)}.footer-grid{display:flex;justify-content:space-between;gap:28px}.footer-brand{font-size:13px;font-weight:800;letter-spacing:.13em}footer p{font-size:13px;margin:10px 0}.footer-grid nav{display:grid;gap:10px;font-size:13px}.legal{font-size:11px;color:var(--muted);margin:28px auto 0}@media(max-width:500px){.footer-grid{flex-direction:column}.footer-grid nav{grid-template-columns:1fr 1fr}}</style>
