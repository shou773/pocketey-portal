---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('news',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const { post }=Astro.props; const { Content }=await render(post);
const d=post.data; const published=d.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
const publicSourceUrl = d.sourceUrl?.includes('data.jma.go.jp/developer/xml/')
  ? 'https://www.jma.go.jp/bosai/'
  : d.sourceUrl;
const imageCredit = [d.imageCredit, d.imageLicense].filter(Boolean).join(' · ');
---
<BaseLayout title={`${d.title} | Pocketey Japan`} description={d.description}>
<article>
  <header class="article-head container"><div class="meta"><span>{d.category}</span><span>{d.location || 'Japan'}</span><span>{published}</span></div><h1 class="display">{d.title}</h1><p class="dek">{d.description}</p></header>
  {d.image ? (
    <figure class="hero-photo">
      <img src={d.image} alt={d.imageAlt || d.title} loading="eager" />
      <figcaption>
        <span>{d.imageContext === 'illustrative' ? 'Illustrative image — not necessarily the current event.' : 'Article image.'}</span>
        <span>
          {d.imageSourceUrl ? <a href={d.imageSourceUrl} target="_blank" rel="noopener">{imageCredit || d.imageProvider || 'Image source'} ↗</a> : imageCredit}
          {d.imageLicenseUrl && <> · <a href={d.imageLicenseUrl} target="_blank" rel="noopener">License ↗</a></>}
        </span>
      </figcaption>
    </figure>
  ) : (
    <div class="hero-image"><div class="circle"></div><span>{d.location || 'JAPAN'}</span></div>
  )}
  <div class="container article-grid">
    <aside><div class="kicker">At a glance</div><p><b>Published</b><br/>{published}</p>{d.updated && <p><b>Updated</b><br/>{d.updated.toLocaleDateString('en-US')}</p>}<p><b>Category</b><br/>{d.category}</p></aside>
    <div class="prose"><Content />{publicSourceUrl && <div class="source"><span class="kicker">Official source</span><a href={publicSourceUrl} rel="nofollow noopener" target="_blank">{d.sourceLabel || 'View official information'} ↗</a></div>}</div>
  </div>
</article>
</BaseLayout>
<style>
.article-head{padding:58px 0 34px}.meta{display:flex;gap:20px;flex-wrap:wrap;font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.article-head h1{font-size:clamp(3rem,6vw,6rem);max-width:1000px;margin:.9rem 0 1.1rem}.dek{font:400 clamp(1.12rem,1.8vw,1.5rem)/1.4 Georgia;max-width:820px;color:#505249}.hero-photo{margin:0;background:#d4d0c6}.hero-photo img{display:block;width:100%;height:clamp(280px,42vw,620px);object-fit:cover}.hero-photo figcaption{max-width:1180px;margin:auto;padding:9px 20px 11px;display:flex;justify-content:space-between;gap:18px;color:#74766d;font-size:.65rem;line-height:1.45}.hero-photo figcaption a{text-decoration:underline;text-underline-offset:2px}.hero-image{height:clamp(260px,32vw,420px);background:#cfd0c4;position:relative;display:grid;place-items:center;overflow:hidden}.hero-image .circle{width:min(30%,320px);aspect-ratio:1;border:1px solid rgba(23,24,19,.28);border-radius:50%}.hero-image:before,.hero-image:after{content:'';position:absolute;border:1px solid rgba(23,24,19,.22);width:54%;height:135%;border-radius:50%}.hero-image:before{left:-12%}.hero-image:after{right:-12%}.hero-image span{position:absolute;bottom:18px;left:24px;font-size:.66rem;letter-spacing:.22em}.article-grid{display:grid;grid-template-columns:200px minmax(0,720px);gap:64px;justify-content:center;padding:52px 0 72px}.article-grid aside{font-size:.8rem;color:var(--muted)}.article-grid aside p{padding:12px 0;border-bottom:1px solid var(--line)}.prose :global(h2){font:400 2.25rem/1.1 Georgia;margin:2.2rem 0 .8rem}.prose :global(h3){font:400 1.5rem/1.2 Georgia;margin:1.8rem 0 .7rem}.prose :global(p),.prose :global(li){font-size:1.02rem;color:#3f413b}.prose :global(a){text-decoration:underline;text-underline-offset:3px}.prose :global(blockquote){border-left:2px solid var(--accent);margin:2rem 0;padding:.4rem 0 .4rem 1.2rem;font:italic 1.2rem Georgia}.source{margin-top:45px;padding:22px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px}.source a{font-size:.85rem}
@media(max-width:760px){.article-head{padding:42px 0 28px}.article-head h1{font-size:clamp(2.7rem,12vw,4.5rem)}.hero-photo img{height:300px}.hero-photo figcaption{display:grid}.hero-image{height:250px}.article-grid{grid-template-columns:1fr;gap:28px;padding-top:38px}.article-grid aside{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.article-grid aside .kicker{grid-column:1/-1}}
@media(max-width:520px){.hero-photo img{height:230px}.hero-image{height:210px}.article-grid aside{grid-template-columns:1fr}.source{flex-direction:column}}
</style>
