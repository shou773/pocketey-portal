---
import BaseLayout from '../layouts/BaseLayout.astro';import T from '../components/T.astro';
---
<BaseLayout title="Contact — Pocketey Games" titleJa="お問い合わせ — Pocketey Games" description="Report a game or site problem, share feedback, or ask about your submitted information." descriptionJa="ゲームやサイトの不具合、ご感想、送信した情報についてのお問い合わせ。"><script is:inline data-turnstile src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script><section class="container prose"><p class="kicker">CONTACT</p><h1 class="display"><T ja="気づいたことを、教えてください。" en="Help us make the next try better."/></h1><p><T ja="ゲームやサイトの不具合、ご感想、プライバシーについてのお問い合わせを受け付けています。ゲーム名・ステージ・端末・ブラウザ・起きたことがあると確認しやすくなります。" en="Send a game or site issue, feedback, or a privacy question. The game, stage, device, browser and what happened help us investigate."/></p></section><section class="container contact-grid"><div class="contact-panel"><h2><T ja="メッセージを送る" en="Send a message"/></h2><p><T ja="送信内容はお問い合わせ対応のために使用します。パスワードや機微な個人情報は入力しないでください。" en="Your submission is used to handle your inquiry. Do not include passwords or sensitive personal information."/> <a href="/privacy/"><T ja="プライバシーについて" en="Privacy details"/></a></p><form id="contact-form" novalidate><div class="field-row"><label><T ja="お名前" en="Name"/><input id="name" name="name" type="text" autocomplete="name" maxlength="100" required/></label><label><T ja="メールアドレス" en="Email"/><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required/></label></div><label><T ja="お問い合わせの種類" en="What is this about?"/><select id="contact-type" name="category" required><option value="Site problem" data-option-ja="ゲーム・サイトの不具合" data-option-en="Game or site problem">Game or site problem</option><option value="Incorrect or outdated information" data-option-ja="説明や表示の修正" data-option-en="Correction to information">Correction to information</option><option value="General inquiry" data-option-ja="その他・プライバシーについて" data-option-en="General or privacy inquiry">General or privacy inquiry</option></select></label><label><T ja="ページURL（任意）" en="Page URL (optional)"/><input id="page-url" name="pageUrl" type="url" inputmode="url" placeholder="https://www.pocketey.com/..." maxlength="1000"/></label><label><T ja="メッセージ" en="Message"/><textarea id="message" name="message" rows="6" minlength="5" maxlength="5000" required></textarea></label><label class="honeypot" aria-hidden="true">Website<input id="website" name="website" type="text" tabindex="-1" autocomplete="off"/></label><div class="turnstile-wrap"><div id="turnstile-widget"></div></div><p class="security-note" id="security-note" aria-live="polite"><T ja="セキュリティ確認を読み込み中です。" en="Loading the security check."/></p><button class="button" id="submit-button" type="submit"><T ja="メッセージを送る" en="Send message"/></button><p class="form-status" id="form-status" aria-live="polite"></p></form></div><aside class="contact-aside"><h2><T ja="メールでも連絡できます" en="Email works too"/></h2><p><T ja="フォームが利用できない場合やメールをご希望の場合は、こちらへご連絡ください。" en="If the form is unavailable or you prefer email, contact us here."/></p><a href="mailto:contact@pocketey.com">contact@pocketey.com</a><h2><T ja="記録について" en="About game records"/></h2><p><T ja="ステージや自己ベストはご自身のブラウザに保存されています。運営側から記録を確認・復元することはできません。" en="Stage progress and personal bests are stored in your own browser. We cannot view or restore those records from our side."/></p></aside></section><script>import {installContact} from '../lib/contact';installContact();</script></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:24px;align-items:start}.contact-panel,.contact-aside{padding:26px;border:1px solid var(--line);border-radius:20px;background:var(--white)}h2{font-size:21px;line-height:1.4;margin:0 0 12px}.contact-grid p{font-size:13px;color:var(--muted)}.contact-grid a{text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.contact-panel form{display:grid;gap:17px;margin-top:24px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:15px}label{display:grid;gap:7px;font-size:13px;font-weight:650}input,select,textarea{width:100%;min-width:0;min-height:46px;padding:11px;border:1px solid var(--line);border-radius:10px;background:white;color:var(--ink);font-size:16px}textarea{resize:vertical;min-height:150px}.honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}.turnstile-wrap{min-height:140px;max-width:100%}.turnstile-wrap>div{width:100%}.security-note,.form-status{font-size:12px!important;margin:0;min-height:1.4em}.error{color:#a4372c!important}.success{color:#27664a!important}.contact-aside h2:not(:first-child){margin-top:28px}@media(max-width:750px){.contact-grid{grid-template-columns:1fr}}@media(max-width:450px){.field-row{grid-template-columns:1fr}.contact-panel,.contact-aside{padding:20px}}</style>
