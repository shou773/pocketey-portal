---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Pocketey Japan"
  description="Report a site problem, flag incorrect travel information, or contact Pocketey Japan."
>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

  <section class="contact-hero container">
    <div class="kicker">Contact Pocketey</div>
    <h1 class="display">Found something we should fix?</h1>
    <p class="lede">Tell us about a site problem, an outdated or incorrect travel detail, or anything else that would make Pocketey more useful.</p>
  </section>

  <section class="container contact-grid">
    <div class="contact-panel">
      <div class="panel-head">
        <span class="pill">Send directly from Pocketey</span>
        <h2>Send a note</h2>
        <p>Your message is sent securely through Pocketey. No email app is required.</p>
      </div>

      <form id="contact-form" novalidate>
        <div class="field-row">
          <label>
            Name
            <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
          </label>

          <label>
            Email
            <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>
        </div>

        <label>
          What is this about?
          <select id="contact-type" name="category" required>
            <option value="Site problem">Site problem</option>
            <option value="Incorrect or outdated information">Incorrect or outdated information</option>
            <option value="General inquiry">General inquiry</option>
          </select>
        </label>

        <label>
          Page URL <span>optional</span>
          <input id="page-url" name="pageUrl" type="url" inputmode="url" placeholder="https://www.pocketey.com/..." maxlength="1000" />
        </label>

        <label>
          Message
          <textarea id="message" name="message" rows="7" minlength="5" maxlength="5000" required placeholder="Please describe the problem, correction, or question. For site issues, your browser/device can also help."></textarea>
        </label>

        <label class="honeypot" aria-hidden="true">
          Website
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>

        <div class="turnstile-wrap">
          <div id="turnstile-widget"></div>
        </div>
        <p class="security-note" id="security-note">The security check normally completes automatically.</p>

        <div class="form-actions">
          <button class="button" id="submit-button" type="submit">Send message</button>
        </div>

        <p class="form-status" id="form-status" aria-live="polite"></p>
        <p class="direct">Prefer email? You can still contact us directly at <a href="mailto:contact@pocketey.com">contact@pocketey.com</a>.</p>
      </form>
    </div>

    <aside class="contact-aside">
      <div class="kicker">Useful details</div>
      <h2>What helps us fix things faster</h2>
      <div class="help-list">
        <article><span>01</span><div><b>For site problems</b><p>The page URL, what you clicked, what happened, and your browser or device.</p></div></article>
        <article><span>02</span><div><b>For incorrect information</b><p>The article URL, the detail that looks wrong, and an official source if you have one.</p></div></article>
        <article><span>03</span><div><b>For general questions</b><p>Keep the message focused so we can understand what you need quickly.</p></div></article>
      </div>
      <div class="privacy-box"><b>Please do not send sensitive personal information.</b><br />Pocketey only needs enough detail to understand the issue.</div>
    </aside>
  </section>

  <script>
    const form = document.querySelector('#contact-form');
    const type = document.querySelector('#contact-type');
    const pageUrl = document.querySelector('#page-url');
    const submitButton = document.querySelector('#submit-button');
    const status = document.querySelector('#form-status');
    const securityNote = document.querySelector('#security-note');

    const params = new URLSearchParams(window.location.search);
    const typeMap = {
      site: 'Site problem',
      info: 'Incorrect or outdated information',
      general: 'General inquiry'
    };

    if (params.get('type') && typeMap[params.get('type')]) {
      type.value = typeMap[params.get('type')];
    }
    if (params.get('url')) pageUrl.value = params.get('url');

    let widgetId = null;
    let turnstileToken = '';

    const setSecurityMessage = (message, isError = false) => {
      if (!securityNote) return;
      securityNote.textContent = message;
      securityNote.classList.toggle('error', isError);
    };

    const renderTurnstile = () => {
      if (!window.turnstile || widgetId !== null) return;

      widgetId = window.turnstile.render('#turnstile-widget', {
        sitekey: '0x4AAAAAAAEnkLqsp7oNIcKXj',
        action: 'contact',
        theme: 'light',
        size: 'flexible',
        retry: 'auto',
        'retry-interval': 3000,
        'refresh-expired': 'auto',
        'refresh-timeout': 'auto',
        'feedback-enabled': false,
        callback: (token) => {
          turnstileToken = token;
          setSecurityMessage('Security check complete.');
        },
        'expired-callback': () => {
          turnstileToken = '';
          setSecurityMessage('Security check expired. It is refreshing automatically.');
        },
        'timeout-callback': () => {
          turnstileToken = '';
          setSecurityMessage('Security check timed out. It is refreshing automatically.', true);
        },
        'error-callback': (errorCode) => {
          turnstileToken = '';
          setSecurityMessage(`Security check could not complete (Cloudflare code ${errorCode}). Please refresh the page. If it continues, try a private window or temporarily disable a content blocker/VPN.`, true);
        }
      });
    };

    const waitForTurnstile = () => {
      if (window.turnstile) {
        renderTurnstile();
      } else {
        window.setTimeout(waitForTurnstile, 150);
      }
    };
    waitForTurnstile();

    const resetTurnstile = () => {
      turnstileToken = '';
      if (window.turnstile && widgetId !== null) {
        try { window.turnstile.reset(widgetId); } catch {}
      }
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      status.className = 'form-status';

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!turnstileToken) {
        status.textContent = 'Please wait for the security check to complete and try again.';
        status.classList.add('error');
        return;
      }

      const payload = {
        name: form.querySelector('#name')?.value || '',
        email: form.querySelector('#email')?.value || '',
        category: type?.value || '',
        pageUrl: pageUrl?.value || '',
        message: form.querySelector('#message')?.value || '',
        website: form.querySelector('#website')?.value || '',
        turnstileToken
      };

      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';

      try {
        const response = await fetch('https://pocketey-contact.shishiyo1.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.ok) {
          throw new Error(result.error || 'Message could not be sent.');
        }

        form.reset();
        if (params.get('type') && typeMap[params.get('type')]) {
          type.value = typeMap[params.get('type')];
        }
        if (params.get('url')) pageUrl.value = params.get('url');
        resetTurnstile();

        status.textContent = 'Thanks — your message has been sent.';
        status.classList.add('success');
      } catch (error) {
        resetTurnstile();
        status.textContent = error?.message || 'Something went wrong. Please try again or email contact@pocketey.com.';
        status.classList.add('error');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send message';
      }
    });
  </script>
</BaseLayout>

<style>
  .contact-hero{padding:76px 0 40px}.contact-hero h1{font-size:clamp(3.3rem,7vw,7.4rem);max-width:970px;margin:.8rem 0 1.2rem}.lede{font:400 clamp(1.12rem,1.8vw,1.45rem)/1.5 Georgia;max-width:760px;color:#55574f}.contact-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.75fr);gap:28px;align-items:start}.contact-panel,.contact-aside{background:#faf8f2;border:1px solid var(--line);border-radius:24px;padding:30px}.panel-head h2,.contact-aside h2{font:400 2rem/1.1 Georgia;margin:1rem 0 .7rem}.panel-head p{color:var(--muted);max-width:680px}.contact-panel form{display:grid;gap:18px;margin-top:28px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.contact-panel label{display:grid;gap:8px;font-size:.78rem;font-weight:700;letter-spacing:.02em}.contact-panel label span{font-weight:400;color:var(--muted)}.contact-panel input,.contact-panel select,.contact-panel textarea{width:100%;border:1px solid #cfcabd;background:#fffdf8;color:var(--ink);border-radius:14px;padding:13px 14px;font:inherit;font-weight:400;letter-spacing:0;outline:none}.contact-panel textarea{resize:vertical;min-height:170px}.contact-panel input:focus,.contact-panel select:focus,.contact-panel textarea:focus{border-color:#7c8175;box-shadow:0 0 0 3px rgba(89,99,83,.08)}.honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}.turnstile-wrap{min-height:66px;display:flex;align-items:center;max-width:100%}.turnstile-wrap>div{width:100%}.security-note{font-size:.74rem;color:var(--muted);margin:-10px 0 0}.security-note.error{color:#9a3e32}.form-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.button:disabled{opacity:.55;cursor:wait;transform:none}.direct,.form-status{font-size:.78rem;color:var(--muted);margin:0}.direct a{text-decoration:underline;text-underline-offset:3px}.form-status{min-height:1.3em;font-weight:650}.form-status.success{color:#48604a}.form-status.error{color:#9a3e32}.help-list{margin-top:18px}.help-list article{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:17px 0;border-top:1px solid var(--line)}.help-list article>span{font:400 .85rem Georgia;color:#8b8d84}.help-list b{font-size:.84rem}.help-list p{font-size:.78rem;color:var(--muted);margin:.3rem 0 0}.privacy-box{margin-top:18px;background:var(--paper-2);border-radius:14px;padding:16px;font-size:.76rem;line-height:1.55;color:#66685f}@media(max-width:850px){.contact-grid{grid-template-columns:1fr}.contact-hero{padding-top:52px}}@media(max-width:620px){.field-row{grid-template-columns:1fr}}@media(max-width:520px){.contact-panel,.contact-aside{padding:22px}.form-actions{align-items:flex-start;flex-direction:column}}
</style>
