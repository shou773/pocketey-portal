---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Pocketey Japan"
  description="Report a site problem, flag incorrect travel information, or contact Pocketey Japan."
>
  <section class="contact-hero container">
    <div class="kicker">Contact Pocketey</div>
    <h1 class="display">Found something we should fix?</h1>
    <p class="lede">Tell us about a site problem, an outdated or incorrect travel detail, or anything else that would make Pocketey more useful.</p>
  </section>

  <section class="container contact-grid">
    <div class="contact-panel">
      <div class="panel-head">
        <span class="pill">Simple email report</span>
        <h2>Send a note</h2>
        <p>This form does not upload or store your message. It prepares an email in your email app so you can review it before sending.</p>
      </div>

      <form id="contact-form">
        <label>
          What is this about?
          <select id="contact-type" name="type">
            <option value="site">Site problem</option>
            <option value="info">Incorrect or outdated information</option>
            <option value="general">General inquiry</option>
          </select>
        </label>

        <label>
          Page URL <span>optional</span>
          <input id="page-url" name="url" type="url" inputmode="url" placeholder="https://www.pocketey.com/..." />
        </label>

        <label>
          What happened?
          <textarea id="message" name="message" rows="7" placeholder="Please describe the problem or correction. For site issues, your browser/device can also help."></textarea>
        </label>

        <div class="form-actions">
          <button class="button" type="submit">Open email app ↗</button>
          <button class="text-button" type="button" id="copy-email">Copy email address</button>
        </div>
        <p class="direct">Or email us directly at <a href="mailto:contact@pocketey.com">contact@pocketey.com</a>.</p>
        <p class="copy-status" id="copy-status" aria-live="polite"></p>
      </form>
    </div>

    <aside class="contact-aside">
      <div class="kicker">Useful details</div>
      <h2>What helps us fix things faster</h2>
      <div class="help-list">
        <article><span>01</span><div><b>For site problems</b><p>The page URL, what you clicked, what happened, and your browser or device.</p></div></article>
        <article><span>02</span><div><b>For incorrect information</b><p>The article URL, the detail that looks wrong, and an official source if you have one.</p></div></article>
        <article><span>03</span><div><b>Screenshots are welcome</b><p>You can attach a screenshot after your email app opens.</p></div></article>
      </div>
      <div class="privacy-box"><b>Please do not send sensitive personal information.</b><br />Pocketey only needs enough detail to understand the issue.</div>
    </aside>
  </section>

  <script>
    const form = document.querySelector('#contact-form');
    const type = document.querySelector('#contact-type');
    const pageUrl = document.querySelector('#page-url');
    const message = document.querySelector('#message');
    const copyButton = document.querySelector('#copy-email');
    const copyStatus = document.querySelector('#copy-status');

    const params = new URLSearchParams(window.location.search);
    if (params.get('type') && ['site', 'info', 'general'].includes(params.get('type'))) {
      type.value = params.get('type');
    }
    if (params.get('url')) pageUrl.value = params.get('url');

    const subjects = {
      site: '[Pocketey Site Issue]',
      info: '[Pocketey Information Correction]',
      general: '[Pocketey Inquiry]'
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const lines = [
        `Page URL: ${pageUrl.value || 'Not provided'}`,
        '',
        message.value || 'Please describe your message here.',
        '',
        '---',
        'Sent from Pocketey Japan contact page.'
      ];
      const mailto = `mailto:contact@pocketey.com?subject=${encodeURIComponent(subjects[type.value])}&body=${encodeURIComponent(lines.join('\n'))}`;
      window.location.href = mailto;
    });

    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('contact@pocketey.com');
        copyStatus.textContent = 'Email address copied.';
      } catch {
        copyStatus.textContent = 'Copy failed. Please copy contact@pocketey.com manually.';
      }
    });
  </script>
</BaseLayout>

<style>
  .contact-hero{padding:76px 0 40px}.contact-hero h1{font-size:clamp(3.3rem,7vw,7.4rem);max-width:970px;margin:.8rem 0 1.2rem}.lede{font:400 clamp(1.12rem,1.8vw,1.45rem)/1.5 Georgia;max-width:760px;color:#55574f}.contact-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.75fr);gap:28px;align-items:start}.contact-panel,.contact-aside{background:#faf8f2;border:1px solid var(--line);border-radius:24px;padding:30px}.panel-head h2,.contact-aside h2{font:400 2rem/1.1 Georgia;margin:1rem 0 .7rem}.panel-head p{color:var(--muted);max-width:680px}.contact-panel form{display:grid;gap:18px;margin-top:28px}.contact-panel label{display:grid;gap:8px;font-size:.78rem;font-weight:700;letter-spacing:.02em}.contact-panel label span{font-weight:400;color:var(--muted)}.contact-panel input,.contact-panel select,.contact-panel textarea{width:100%;border:1px solid #cfcabd;background:#fffdf8;color:var(--ink);border-radius:14px;padding:13px 14px;font:inherit;font-weight:400;letter-spacing:0;outline:none}.contact-panel textarea{resize:vertical;min-height:170px}.contact-panel input:focus,.contact-panel select:focus,.contact-panel textarea:focus{border-color:#7c8175;box-shadow:0 0 0 3px rgba(89,99,83,.08)}.form-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.text-button{border:0;background:none;padding:.7rem 0;font-weight:650;text-decoration:underline;text-underline-offset:4px;cursor:pointer}.direct,.copy-status{font-size:.78rem;color:var(--muted);margin:0}.direct a{text-decoration:underline;text-underline-offset:3px}.copy-status{min-height:1.2em}.help-list{margin-top:18px}.help-list article{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:17px 0;border-top:1px solid var(--line)}.help-list article>span{font:400 .85rem Georgia;color:#8b8d84}.help-list b{font-size:.84rem}.help-list p{font-size:.78rem;color:var(--muted);margin:.3rem 0 0}.privacy-box{margin-top:18px;background:var(--paper-2);border-radius:14px;padding:16px;font-size:.76rem;line-height:1.55;color:#66685f}@media(max-width:850px){.contact-grid{grid-template-columns:1fr}.contact-hero{padding-top:52px}}@media(max-width:520px){.contact-panel,.contact-aside{padding:22px}.form-actions{align-items:flex-start;flex-direction:column}}
</style>
