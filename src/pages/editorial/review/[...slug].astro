mage-fallback-card{margin:28px 0;padding:20px;border:1px dashed #c9c3b7;border-radius:16px;background:#f1eee5}.image-fallback-card h3{font:400 1.35rem Georgia,serif;margin:.4rem 0}.image-fallback-card p{font-size:.8rem;color:#6f7168}.prose :global(h2){font:400 2rem/1.12 Georgia,serif;margin:2.1rem 0 .7rem}.prose :global(p),.prose :global(li){font-size:.98rem;color:#41433d}.source-box{display:flex;justify-content:space-between;gap:18px;margin-top:38px;padding-top:18px;border-top:1px solid #d9d5cb;font-size:.76rem}.ja-verification{margin-top:26px;padding:22px;border:1px solid #d8d2c5;background:#f1eee5;border-radius:16px}.ja-verification h3{font:400 1.45rem Georgia,serif;margin:.35rem 0 .7rem}.ja-verification p{font-size:.9rem;line-height:1.75}.ja-caution{margin-top:14px;padding-top:12px;border-top:1px solid #d9d4c9;color:#7b7d74;font-size:.68rem}.review-sidebar{display:grid;gap:14px;align-content:start;position:sticky;top:88px}.check-panel,.publish-panel,.meta-panel{padding:20px}.check-panel h2,.publish-panel h2{font:400 1.65rem Georgia,serif;margin:.25rem 0}.hint{font-size:.7rem;color:#8a8c84}.check-panel label{display:grid;grid-template-columns:20px 1fr;gap:10px;padding:13px 0;border-top:1px solid #e0dcd2}.check-panel label span{display:grid}.check-panel label b{font-size:.77rem}.check-panel label small{font-size:.68rem;color:#81837a}.check-progress{height:6px;background:#e1ddd3;border-radius:999px;margin-top:15px;overflow:hidden}.check-progress span{display:block;width:0;height:100%;background:#596353}.check-count{font-size:.65rem;color:#808279;margin-top:7px}.publish-panel>p{font-size:.74rem;color:#72746b}.path-box{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;background:#ece9e0;border-radius:10px;padding:10px;margin:13px 0}.path-box code{font-size:.63rem;word-break:break-all}.path-box button{border:0;background:#fff;border-radius:8px;padding:6px 9px}.publish-button{width:100%;opacity:.45;pointer-events:none}.publish-button[data-ready="true"]{opacity:1;pointer-events:auto}.publish-help{display:block;color:#85877e;font-size:.65rem;margin-top:9px}.meta-panel>div{display:grid;gap:3px;padding:10px 0;border-bottom:1px solid #e2ded4}.meta-panel span{font-size:.62rem;text-transform:uppercase;color:#8b8d84}.meta-panel b,.meta-panel code{font-size:.7rem;word-break:break-all}@media(max-width:1000px){.review-grid{grid-template-columns:1fr}.review-sidebar{position:static}}@media(max-width:720px){.review-head-grid{grid-template-columns:1fr}.review-topbar{display:grid}.preview-label,.source-box{display:grid}}
</style>