---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const posts = await getCollection('news');
const byNewest = [...posts].sort((a, b) => {
  const ad = (a.data.updated ?? a.data.date).getTime();
  const bd = (b.data.updated ?? b.data.date).getTime();
  return bd - ad;
});

const drafts = byNewest.filter((post) => post.data.draft);
const published = byNewest.filter((post) => !post.data.draft);

const queueDir = path.resolve(process.cwd(), 'data/editorial');
const queueFiles = fs.existsSync(queueDir)
  ? fs.readdirSync(queueDir).filter((name) => name.endsWith('.json')).sort().reverse()
  : [];
const queues = queueFiles.map((name) => {
  try {
    return JSON.parse(fs.readFileSync(path.join(queueDir, name), 'utf-8'));
  } catch {
    return null;
  }
}).filter(Boolean);

const latestQueue = queues[0] ?? { run_date: '—', run_summary: '', candidates: [] };
const candidates = Array.isArray(latestQueue.candidates) ? latestQueue.candidates : [];
const researchCandidates = candidates.filter((item) => String(item.recommendation).toLowerCase() === 'publish');
const watchCandidates = candidates.filter((item) => String(item.recommendation).toLowerCase() === 'watch');

function formatDate(value) {
  if (!value) return '—';
  const d = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(d.getTime())) return String(value);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function repoPath(post) {
  const filePath = post.filePath;
  if (filePath) return path.relative(process.cwd(), filePath).replaceAll('\\', '/');
  return `src/content/news/${post.id}${post.id.endsWith('.md') || post.id.endsWith('.mdx') ? '' : '.md'}`;
}

function reviewHref(post) {
  return `/editorial/review/${post.id}/`;
}

function githubHref(post) {
  return `https://github.com/shou773/pocketey-portal/blob/main/${repoPath(post)}`;
}
---
<EditorialLayout title="Pocketey Editorial Desk — Review Dashboard">
  <section class="hero desk-wrap">
    <div>
      <div class="desk-kicker">Editorial operations</div>
      <h1>Research first.<br /><em>Review drafts second.</em></h1>
      <p>The dashboard now separates research candidates from actual drafts that require your approval.</p>
    </div>
    <div class="hero-note">
      <b>Monitoring cadence</b>
      <span>3× daily</span>
      <small>07:17 · 14:17 · 21:17 JST</small>
    </div>
  </section>

  <section class="workflow desk-wrap" aria-label="Editorial workflow">
    <div><b>1</b><span>Research candidate</span><small>AI finds a potentially useful story.</small></div>
    <i>→</i>
    <div><b>2</b><span>Draft generated</span><small>A reviewable article file is created.</small></div>
    <i>→</i>
    <div><b>3</b><span>Human review</span><small>You verify source, wording and image.</small></div>
    <i>→</i>
    <div><b>4</b><span>Published</span><small>The article becomes public.</small></div>
  </section>

  <section class="stats desk-wrap" aria-label="Editorial status overview">
    <article class="important"><span>Drafts needing your review</span><strong>{drafts.length}</strong><small>{drafts.length === 0 ? 'No action required now' : 'Action required'}</small></article>
    <article><span>Research candidates</span><strong>{researchCandidates.length}</strong><small>Ideas found in latest research run — not review tasks</small></article>
    <article><span>Watch list</span><strong>{watchCandidates.length}</strong><small>Interesting, but not strong enough to draft</small></article>
    <article><span>Published</span><strong>{published.length}</strong><small>Articles currently in the content collection</small></article>
  </section>

  <section class="desk-wrap explainer">
    <b>How to read these numbers</b>
    <p><strong>Research candidates</strong> can be greater than zero even when <strong>Drafts needing your review</strong> is zero. A candidate is only a research-stage recommendation. You only need to act when a real draft appears in the first box.</p>
  </section>

  <section class="desk-wrap section-block">
    <div class="section-head">
      <div><div class="desk-kicker">Your action queue</div><h2>Drafts waiting for review</h2></div>
      <span class="section-caption">Only items here need your attention</span>
    </div>

    {drafts.length === 0 ? (
      <div class="empty-state success">
        <b>Nothing to review right now.</b>
        <p>You do not need to do anything. Research candidates below are informational until the system creates a draft.</p>
      </div>
    ) : (
      <div class="draft-list">
        {drafts.map((post, index) => (
          <article class="draft-card">
            <div class="draft-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="draft-main">
              <div class="draft-meta">
                <span class="desk-badge">Needs review</span>
                <span>{post.data.category}</span>
                <span>{post.data.location || 'Japan'}</span>
                <span>Updated {formatDate(post.data.updated ?? post.data.date)}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="draft-source">Source: <b>{post.data.sourceLabel || 'Official source'}</b></div>
            </div>
            <div class="draft-actions">
              <a class="desk-button primary" href={reviewHref(post)}>Review draft</a>
              {post.data.sourceUrl && <a class="desk-button" href={post.data.sourceUrl} target="_blank" rel="noopener">Official source ↗</a>}
              <a class="desk-button" href={githubHref(post)} target="_blank" rel="noopener">GitHub ↗</a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="desk-wrap section-block split-grid">
    <div class="queue-panel">
      <div class="section-head compact">
        <div><div class="desk-kicker">Research only — no action required</div><h2>Latest research candidates · {latestQueue.run_date}</h2></div>
        <a class="desk-button" href="https://github.com/shou773/pocketey-portal/tree/main/data/editorial" target="_blank" rel="noopener">Queue files ↗</a>
      </div>
      {latestQueue.run_summary && <p class="queue-summary">{latestQueue.run_summary}</p>}
      <div class="candidate-list">
        {candidates.length === 0 ? <p class="muted">No candidates in the latest queue.</p> : candidates.map((item, index) => (
          <article class="candidate">
            <div class="score">{item.scores?.total ?? 0}<small>/100</small></div>
            <div>
              <div class="candidate-top">
                <span class={`desk-badge ${String(item.recommendation).toLowerCase() === 'publish' ? 'research' : 'watch'}`}>
                  {String(item.recommendation).toLowerCase() === 'publish' ? 'RESEARCH CANDIDATE' : 'WATCH'}
                </span>
                <span>{item.category}</span>
              </div>
              <h3>{index + 1}. {item.title}</h3>
              <p>{item.why_it_matters}</p>
              <div class="candidate-state">Status: <b>{String(item.recommendation).toLowerCase() === 'publish' ? 'Eligible for drafting; not waiting for your review yet' : 'Watch only'}</b></div>
              {item.japanese_verification_summary && (
                <div class="candidate-ja">
                  <b>日本語検証メモ</b>
                  <p>{item.japanese_verification_summary}</p>
                </div>
              )}
              <div class="candidate-links">
                {item.primary_source_url && <a href={item.primary_source_url} target="_blank" rel="noopener">Open primary source ↗</a>}
                {item.japanese_source_url && <a href={item.japanese_source_url} target="_blank" rel="noopener">日本語公式ソース ↗</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <aside class="ops-panel">
      <div class="desk-kicker">When action is needed</div>
      <h2>Review only real drafts</h2>
      <ol>
        <li><span>01</span><div><b>Check the first counter</b><p>If “Drafts needing your review” is 0, there is nothing you need to do.</p></div></li>
        <li><span>02</span><div><b>Ignore candidate count as a task count</b><p>Research candidates are AI recommendations, not pending approvals.</p></div></li>
        <li><span>03</span><div><b>Review a generated draft</b><p>When a draft appears, verify the official source, article wording and image.</p></div></li>
        <li><span>04</span><div><b>Publish deliberately</b><p>Approve only after the review checklist is complete.</p></div></li>
      </ol>
      <div class="privacy-note"><b>Unlisted, not private.</b><br />This page is excluded from indexing and the sitemap, but GitHub Pages does not provide authentication.</div>
    </aside>
  </section>

  <section class="desk-wrap section-block">
    <div class="section-head"><div><div class="desk-kicker">Recently live</div><h2>Published articles</h2></div></div>
    <div class="published-row">
      {published.slice(0, 6).map((post) => (
        <a class="published-card" href={`/news/${post.id}/`} target="_blank">
          <span class="desk-badge published">Published</span>
          <h3>{post.data.title}</h3>
          <small>{formatDate(post.data.updated ?? post.data.date)} · {post.data.category}</small>
        </a>
      ))}
    </div>
  </section>
</EditorialLayout>

<style>
