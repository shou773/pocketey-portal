rtant;line-height:1.55;margin:.25rem 0 0!important}.ops-panel h2{font:400 1.8rem Georgia,serif;margin:.25rem 0 14px}.ops-panel ol{list-style:none;padding:0;margin:0}.ops-panel li{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:14px 0;border-top:1px solid #dfdbd1}.ops-panel li>span{font:400 .75rem Georgia,serif;color:#989991}.ops-panel b{font-size:.78rem}.ops-panel p{font-size:.73rem;line-height:1.45;color:#777970;margin:.25rem 0 0}.privacy-note{margin-top:18px;padding:14px;border-radius:12px;background:#ece8de;color:#777970;font-size:.7rem;line-height:1.55}.published-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.published-card{background:#faf8f2;border:1px solid #d7d2c7;border-radius:16px;padding:18px;min-height:150px;display:flex;flex-direction:column}.published-card h3{font:400 1.15rem/1.2 Georgia,serif;margin:.8rem 0 auto}.published-card small{color:#85867e;margin-top:14px}.desk-badge{display:inline-flex;width:max-content;padding:4px 7px;border-radius:999px;background:#ddd9cd;font-size:.58rem;letter-spacing:.07em}.desk-badge.research{background:#e5e8dc}.desk-badge.watch{background:#ece7db}.desk-badge.published{background:#e0e8df}.desk-button{display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbc7bb;border-radius:999px;padding:8px 11px;font-size:.7rem}.desk-button.primary{background:#262822;color:#fff;border-color:#262822}@media(max-width:980px){.workflow{grid-template-columns:1fr}.workflow i{display:none}.stats{grid-template-columns:repeat(2,1fr)}.split-grid{grid-template-columns:1fr}.published-row{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.hero{display:grid;padding-top:38px}.hero-note{border-left:0;border-top:1px solid #ccc8bc;padding:16px 0 0}.draft-card{grid-template-columns:32px 1fr}.draft-actions{grid-column:2;display:flex;flex-wrap:wrap}.published-row{grid-template-columns:1fr}}@media(max-width:520px){.stats{grid-template-columns:1fr}.stats article{border-right:0;border-bottom:1px