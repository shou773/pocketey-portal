<style>.legalpage{max-width:850px;padding:85px 0 120px}.legalpage h1{font-size:clamp(4rem,8vw,7rem);margin:.5rem 0 2rem}.legalpage h2{font:400 1.8rem Georgia;margin-top:2.3rem}.legalpage p{color:#44463f}</style>
