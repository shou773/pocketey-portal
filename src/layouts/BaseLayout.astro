---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocaleHead from '../components/LocaleHead.astro';
import T from '../components/T.astro';
import '../styles/global.css';
const {title='Pocketey Games — Small adventures, one more try',titleJa='Pocketey Games — 小さな冒険を、ポケットに。',description='Four original browser action games. Three stages each. Touch or keyboard. No account required.',descriptionJa='タッチでもキーボードでも遊べる、4つのオリジナルブラウザゲーム。各3ステージ、アカウント不要。',noindex=false,portal=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><LocaleHead/><title data-ja={titleJa} data-en={title}>{title}</title><meta name="description" content={description} data-ja={descriptionJa} data-en={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex"/>}<meta property="og:type" content="website"/><meta property="og:title" content={title} data-ja={titleJa} data-en={title}/><meta property="og:description" content={description} data-ja={descriptionJa} data-en={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/og-default.svg',Astro.site)}/><meta name="theme-color" content={portal?'#191c25':'#f4f1e9'}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body class:list={[{'portal-page':portal}]}><a class="skip-link" href="#main"><T ja="本文へ移動" en="Skip to content"/></a><Header portal={portal}/><main id="main"><slot/></main><Footer/><script>import {installLocale} from '../lib/locale';installLocale();</script></body></html>
