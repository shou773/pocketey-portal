---
import '../styles/global.css';
const {
  title = 'Pocketey Editorial Desk',
  description = 'Internal editorial review dashboard for Pocketey Japan.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#171813" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="editorial-shell">
  <header class="desk-header">
    <div class="desk-wrap desk-header-inner">
      <a class="desk-brand" href="/editorial/">
        <span class="desk-mark">P</span>
        <span><b>Pocketey</b><small>Editorial Desk</small></span>
      </a>
      <nav class="desk-nav" aria-label="Editorial navigation">
        <a href="/editorial/">Dashboard</a>
        <a href="https://github.com/shou773/pocketey-portal/actions/workflows/editorial-engine.yml" target="_blank" rel="noopener">Run engine ↗</a>
        <a href="https://github.com/shou773/pocketey-portal/actions/workflows/publish-draft.yml" target="_blank" rel="noopener">Publish ↗</a>
        <a href="/" target="_blank">Public site ↗</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="desk-footer">
    <div class="desk-wrap">
      <span>Pocketey Editorial Desk</span>
      <span>Traveler first · Human approval required</span>
    </div>
  </footer>
</body>
</html>
<style is:global>
  .editorial-shell{background:#f1efe8;color:#171813;min-height:100vh}.desk-wrap{width:min(calc(100% - 36px),1280px);margin-inline:auto}.desk-header{position:sticky;top:0;z-index:50;background:rgba(23,24,19,.96);color:#f7f4ec;border-bottom:1px solid rgba(255,255,255,.12);backdrop-filter:blur(14px)}.desk-header-inner{height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px}.desk-brand{display:flex;align-items:center;gap:10px}.desk-brand>span:last-child{display:grid;line-height:1.05}.desk-brand b{font:600 1rem Georgia,serif;letter-spacing:.01em}.desk-brand small{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:#aaa99f;margin-top:4px}.desk-mark{width:34px;height:34px;border:1px solid #77786f;border-radius:50%;display:grid;place-items:center;font:italic 1.1rem Georgia,serif}.desk-nav{display:flex;gap:18px;align-items:center;font-size:.75rem;color:#c7c6bd}.desk-nav a:hover{color:#fff}.desk-footer{border-top:1px solid #d7d2c5;margin-top:70px;padding:22px 0 34px;color:#74766d;font-size:.72rem}.desk-footer .desk-wrap{display:flex;justify-content:space-between;gap:20px}.desk-kicker{text-transform:uppercase;letter-spacing:.17em;font-size:.68rem;font-weight:750;color:#687264}.desk-button{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 14px;border:1px solid #bbb8ae;border-radius:999px;font-size:.75rem;font-weight:700;background:#faf8f2;transition:.18s ease}.desk-button:hover{transform:translateY(-1px);border-color:#62655d;background:#fff}.desk-button.primary{background:#171813;color:#fff;border-color:#171813}.desk-button.primary:hover{background:#35362f}.desk-badge{display:inline-flex;align-items:center;gap:7px;padding:6px 9px;border-radius:999px;background:#e7e4da;font-size:.67rem;font-weight:750;letter-spacing:.04em}.desk-badge:before{content:'';width:7px;height:7px;border-radius:50%;background:#9a6a43}.desk-badge.published:before{background:#596d5b}.desk-badge.watch:before{background:#9a8249}.desk-badge.queue:before{background:#69707a}@media(max-width:820px){.desk-header{position:relative}.desk-header-inner{height:auto;padding:14px 0;align-items:flex-start}.desk-nav{gap:10px;flex-wrap:wrap;justify-content:flex-end}.desk-nav a:nth-child(2){display:none}}@media(max-width:560px){.desk-wrap{width:min(calc(100% - 24px),1280px)}.desk-header-inner{display:block}.desk-nav{justify-content:flex-start;margin-top:12px}.desk-footer .desk-wrap{display:grid}.desk-brand{width:max-content}}
</style>
